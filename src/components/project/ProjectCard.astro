---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  index: string;
  href: string;
  title: string;
  context: string;
  summary: string;
  stack: readonly string[];
  evidence: readonly string[];
  media?: ImageMetadata;
  alt?: string;
  /** Credit for licensed cover media — a licence that asks for it asks everywhere. */
  credit?: string;
  creditHref?: string;
  /** A silent looping clip. Falls back to the poster under reduced motion. */
  video?: { mp4: string; webm?: string; poster: string };
  flip?: boolean;
  eager?: boolean;
  /** Call to action, supplied by the page in its own language. */
  cta: string;
}

const {
  index,
  href,
  title,
  context,
  summary,
  stack,
  evidence,
  media,
  alt,
  credit,
  creditHref,
  video,
  flip = false,
  eager = false,
  cta,
} = Astro.props;
---

<div class="card-container">
  <article class:list={['card', 'ticks', { 'card--flip': flip }]}>
    <div class="card__visual">
      <div class="card__media">
        {
          video && (
            <video
              data-loop
              muted
              loop
              playsinline
              autoplay
              preload="metadata"
              poster={video.poster}
              aria-label={alt}
            >
              {video.webm && <source src={video.webm} type="video/webm" />}
              <source src={video.mp4} type="video/mp4" />
            </video>
          )
        }
        {
          !video && media && alt && (
            <Image
              src={media}
              alt={alt}
              widths={[480, 768, 1024, 1440]}
              sizes="(min-width: 1024px) 46vw, 100vw"
              loading={eager ? 'eager' : 'lazy'}
              decoding="async"
            />
          )
        }
        <slot name="media" />
      </div>

      {
        credit && (
          <p class="card__credit mono">
            {creditHref ? (
              <a href={creditHref} rel="noopener noreferrer" target="_blank">
                {credit}
              </a>
            ) : (
              credit
            )}
          </p>
        )
      }
    </div>

    <div class="card__body">
      <p class="card__index mono">{index}</p>
      <h3 class="card__title">
        <a class="card__link" href={href}>{title}</a>
      </h3>
      <p class="card__context mono">{context}</p>
      <p class="card__summary">{summary}</p>

      <ul class="chips" role="list">
        {stack.map((item) => <li class="chip">{item}</li>)}
      </ul>

      <p class="card__evidence label">{evidence.join(' · ')}</p>

      <p class="card__cta">
        <span>{cta}</span>
        <span class="arrow" aria-hidden="true">→</span>
      </p>
    </div>
  </article>
</div>

<style>
  .card-container {
    container: project-card / inline-size;
  }

  .card {
    position: relative;
    display: grid;
    gap: var(--space-6);
    padding: var(--space-6);
    background: var(--surface);
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius);
    transition:
      border-color var(--dur-fast) var(--ease-inout),
      box-shadow var(--dur-fast) var(--ease-inout);
  }

  /* An accent rule draws across the top edge on hover. design-spec.md §7.3. */
  .card::after {
    content: '';
    position: absolute;
    inset-block-start: -1px;
    inset-inline-start: -1px;
    width: calc(100% + 2px);
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-fast) var(--ease-inout);
  }

  .card:hover,
  .card:has(.card__link:focus-visible) {
    border-color: var(--border-ui);
    box-shadow: var(--shadow-raised);
  }

  .card:hover::after,
  .card:has(.card__link:focus-visible)::after {
    transform: scaleX(1);
  }

  /* The whole card is one link target, without nesting interactive elements. */
  .card__link {
    text-decoration: none;
  }

  .card__link::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
  }

  .card__visual,
  .card__body {
    min-inline-size: 0;
  }

  .card__media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--surface-sunken);
    border: 1px solid var(--border-hairline);
  }

  .card__media :global(img),
  .card__media :global(video) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 16 / 10;
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .card:hover .card__media :global(img),
  .card:hover .card__media :global(video) {
    transform: scale(1.02);
  }

  @media (prefers-reduced-motion: reduce) {
    .card__media :global(img),
    .card__media :global(video) {
      transition: none;
    }
    .card:hover .card__media :global(img),
    .card:hover .card__media :global(video) {
      transform: none;
    }
  }

  /* Keep each credit with its media when the two-column card alternates. */
  .card__credit {
    margin-block-start: var(--space-2);
    font-size: var(--text-mono);
    color: var(--text-muted);
  }

  /* The card's ::before overlay makes the whole surface one link target; the
     credit has to sit above it to stay clickable, as the licence requires. */
  .card__credit a {
    position: relative;
    z-index: 1;
    color: inherit;
    text-decoration-color: var(--border-ui);
    text-underline-offset: 0.2em;
  }

  .card__credit a:hover {
    color: var(--text-secondary);
    text-decoration-color: currentcolor;
  }

  .card__body {
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }

  .card__index {
    color: var(--text-muted);
    letter-spacing: 0.08em;
  }

  .card__title {
    font-size: var(--text-h3);
    max-width: 22ch;
  }

  .card__context {
    color: var(--text-secondary);
  }

  .card__summary {
    color: var(--text-secondary);
    max-width: 52ch;
  }

  .card__evidence {
    color: var(--text-muted);
  }

  .card__cta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-small);
    font-weight: 500;
  }

  .card__cta .arrow {
    transition: transform var(--dur-fast) var(--ease-inout);
  }

  .card:hover .card__cta .arrow {
    transform: translateX(4px);
  }

  /* Cards respond to their own width, not the viewport. site-plan.md §10. */
  @container project-card (min-width: 780px) {
    .card {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      align-items: center;
      gap: var(--space-8);
      padding: var(--space-7);
    }

    .card--flip .card__visual {
      order: 2;
    }
  }

  @supports not (container-type: inline-size) {
    @media (width >= 1024px) {
      .card {
        grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
        align-items: center;
        gap: var(--space-8);
        padding: var(--space-7);
      }
      .card--flip .card__visual {
        order: 2;
      }
    }
  }
</style>

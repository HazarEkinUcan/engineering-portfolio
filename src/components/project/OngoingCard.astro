---
/**
 * Card for a build that is underway.
 *
 * Same design language as ProjectCard — same frame, radius, hover rule, media
 * ratio, type scale — with three deliberate differences, each of which says
 * "not finished" without inventing a second visual system:
 *
 *   · the index number is replaced by an ONGOING chip. On a completed card that
 *     slot means "ranked, finished work"; here it carries the status instead, in
 *     the same position so the two card types still line up.
 *   · the evidence row becomes a target line. There is no evidence yet.
 *   · the call to action reads "Follow the build".
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  href: string;
  title: string;
  context: string;
  summary: string;
  targetLine: string;
  statusLine: string;
  updated: string;
  media?: ImageMetadata;
  alt?: string;
  caption?: string;
  /** Concept art is shown whole rather than cropped to the card ratio. */
  contain?: boolean;
  /** The three visible labels, supplied by the page in its own language. */
  statusChip: string;
  updatedLabel: string;
  cta: string;
  /** Shown in place of the media frame while there is no concept visual yet. */
  pendingLabel: string;
}

const {
  href,
  title,
  context,
  summary,
  targetLine,
  statusLine,
  updated,
  media,
  alt,
  caption,
  contain = true,
  statusChip,
  updatedLabel,
  cta,
  pendingLabel,
} = Astro.props;
---

<article class="card card--ongoing ticks">
  <div
    class:list={[
      'card__media',
      {
        'card__media--contain': contain,
        'card__media--tall': contain && media && media.height >= media.width,
      },
    ]}
  >
    {
      media && alt && (
        <Image
          src={media}
          alt={alt}
          widths={[480, 768, 1024]}
          sizes="(min-width: 1024px) 46vw, 100vw"
          loading="lazy"
          decoding="async"
        />
      )
    }
    {!media && <p class="card__pending mono">{pendingLabel}</p>}
  </div>

  {caption && <p class="card__caption mono">{caption}</p>}

  <div class="card__body">
    <p class="card__status"><span class="chip chip--ongoing mono">{statusChip}</span></p>

    <h3 class="card__title">
      <a class="card__link" href={href}>{title}</a>
    </h3>

    <p class="card__context mono">{context}</p>
    <p class="card__summary">{summary}</p>

    <p class="card__targets label">{targetLine}</p>

    <p class="card__state mono">{statusLine}</p>
    <p class="card__updated mono">{updatedLabel} {updated}</p>

    <p class="card__cta">
      <span>{cta}</span>
      <span class="arrow" aria-hidden="true">→</span>
    </p>
  </div>
</article>

<style>
  /* Everything down to .card__body is intentionally identical to ProjectCard —
     the two sit in the same column and must read as the same object. */
  .card {
    position: relative;
    display: grid;
    gap: var(--space-6);
    padding: var(--space-6);
    background: var(--surface);
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius);
    container-type: inline-size;
    transition:
      border-color var(--dur-fast) var(--ease-inout),
      box-shadow var(--dur-fast) var(--ease-inout);
  }

  .card::after {
    content: '';
    position: absolute;
    inset-block-start: -1px;
    inset-inline-start: -1px;
    width: calc(100% + 2px);
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-fast) var(--ease-inout);
  }

  .card:hover,
  .card:has(.card__link:focus-visible) {
    border-color: var(--border-ui);
    box-shadow: var(--shadow-raised);
  }

  .card:hover::after,
  .card:has(.card__link:focus-visible)::after {
    transform: scaleX(1);
  }

  .card__link {
    text-decoration: none;
  }

  .card__link::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
  }

  .card__media {
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--surface-sunken);
    border: 1px solid var(--border-hairline);
    aspect-ratio: 16 / 10;
  }

  /* Base: fill the 16:10 frame and cover, exactly as a completed card does. An
     image already at the card ratio needs nothing else.

     Filling the box and letting object-fit decide is also what actually
     constrains the image. A percentage max-height does not: the box gets its
     height from aspect-ratio, and a percentage resolved against that lets the
     width win and the height run past the frame. */
  .card__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease-out);
  }

  /* Contained instead, for artwork that must not be cropped — a subject that
     fills its own square frame, or a transparent ground that should show the
     theme's surface rather than be cut to a wide box. */
  .card__media--contain {
    padding: var(--space-5);
  }

  /* Tall and square artwork otherwise becomes a thumbnail inside two layers
     of padding on phones. Keep a safe inset and the complete silhouette. */
  @media (width < 640px) {
    .card__media--tall {
      padding: var(--space-2);
    }
  }

  .card__media--contain :global(img) {
    object-fit: contain;
  }

  .card:hover .card__media :global(img) {
    transform: scale(1.02);
  }

  @media (prefers-reduced-motion: reduce) {
    .card__media :global(img) {
      transition: none;
    }
    .card:hover .card__media :global(img) {
      transform: none;
    }
  }

  /* The empty state, for before the concept art exists. It holds the exact 16:10
     box the image will occupy, so nothing reflows when the file arrives. */
  .card__pending {
    display: grid;
    place-items: center;
    height: 100%;
    margin: 0;
    color: var(--text-muted);
  }

  .card__caption {
    margin-block-start: calc(var(--space-2) - var(--space-6));
    font-size: var(--text-mono);
    color: var(--text-muted);
  }

  .card__body {
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }

  /* Sits exactly where a completed card puts its index number. */
  .card__status {
    display: flex;
  }

  .card__title {
    font-size: var(--text-h3);
    max-width: 22ch;
  }

  .card__context {
    color: var(--text-secondary);
  }

  .card__summary {
    color: var(--text-secondary);
    max-width: 52ch;
  }

  /* Stands where a completed card lists its evidence — targets, not results. */
  .card__targets {
    color: var(--text-muted);
  }

  .card__state {
    padding-inline-start: var(--space-4);
    border-inline-start: 2px solid var(--accent);
    color: var(--text-secondary);
  }

  .card__updated {
    margin-block-start: calc(var(--space-4) * -1 + var(--space-2));
    color: var(--text-muted);
  }

  .card__cta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-small);
    font-weight: 500;
  }
</style>

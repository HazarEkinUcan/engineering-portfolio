---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption: string;
  /** Screenshots get a hairline frame so they read as artefacts. */
  screenshot?: boolean;
  wide?: boolean;
  eager?: boolean;
  /** Credit line for licensed media, rendered under the caption. */
  credit?: string;
  creditHref?: string;
}
const {
  src,
  alt,
  caption,
  screenshot = false,
  wide = false,
  eager = false,
  credit,
  creditHref,
} = Astro.props;
---

<figure class:list={['figure', 'reveal', { bleed: wide }]}>
  <div class:list={['figure__frame', { 'figure__frame--plain': !screenshot }]}>
    <Image
      src={src}
      alt={alt}
      widths={[480, 768, 1024, 1440, 1920]}
      sizes={wide ? '(min-width: 1280px) 1100px, 100vw' : '(min-width: 768px) 720px, 100vw'}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
  </div>
  <figcaption>{caption}</figcaption>
  {
    credit && (
      <p class="figure__credit mono">
        {creditHref ? (
          <a class="draw-link" href={creditHref} rel="noopener noreferrer" target="_blank">
            {credit}
          </a>
        ) : (
          credit
        )}
      </p>
    )
  }
</figure>

<style>
  .figure {
    margin-block: var(--space-8);
  }

  /* A licence that requires credit requires it wherever the image appears. */
  .figure__credit {
    margin-block-start: var(--space-2);
    font-size: var(--text-label);
    color: var(--text-muted);
  }
</style>

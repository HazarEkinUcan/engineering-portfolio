---
import type { TimelineEntry } from '../../data/timeline';

interface Props {
  entries: TimelineEntry[];
  compact?: boolean;
}
const { entries, compact = false } = Astro.props;
---

<ol class="timeline" role="list">
  {
    entries.map((entry) => (
      <li class="timeline__item rail reveal">
        <span class="rail__node" aria-hidden="true" />
        <p class="timeline__period mono">{entry.period}</p>
        <h3 class="timeline__title">{entry.title}</h3>
        <p class="timeline__org">
          {entry.org}
          <span class="timeline__place">{entry.place}</span>
        </p>
        {!compact && entry.detail && <p class="timeline__detail">{entry.detail}</p>}
        {!compact && entry.bullets && (
          <ul class="timeline__bullets" role="list">
            {entry.bullets.map((bullet) => (
              <li>{bullet}</li>
            ))}
          </ul>
        )}
        {!compact && entry.link && (
          <p class="timeline__link">
            <a class="draw-link" href={entry.link.href}>
              {entry.link.label} <span aria-hidden="true">→</span>
            </a>
          </p>
        )}
      </li>
    ))
  }
</ol>

<style>
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-8);
  }

  .timeline__item {
    padding-block-end: var(--space-2);
  }

  .timeline__period {
    color: var(--text-muted);
    margin-block-end: var(--space-2);
  }

  .timeline__title {
    font-size: var(--text-h3);
  }

  .timeline__org {
    margin-block-start: var(--space-1);
    color: var(--text-secondary);
    font-size: var(--text-small);
  }

  .timeline__place {
    display: block;
    color: var(--text-muted);
  }

  .timeline__detail {
    margin-block-start: var(--space-4);
    color: var(--text-secondary);
    max-width: var(--w-prose);
  }

  .timeline__bullets {
    margin-block-start: var(--space-4);
    padding-inline-start: 0;
    list-style: none;
    display: grid;
    gap: var(--space-3);
    max-width: var(--w-prose);
    font-size: var(--text-small);
  }

  .timeline__bullets li {
    position: relative;
    padding-inline-start: var(--space-5);
    color: var(--text-secondary);
  }

  .timeline__bullets li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0.62em;
    width: 4px;
    height: 4px;
    background: var(--border-ui);
  }

  .timeline__link {
    margin-block-start: var(--space-4);
    font-size: var(--text-small);
  }
</style>
